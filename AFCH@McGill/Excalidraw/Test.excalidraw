library IEEE;
use IEEE.std_logic_1164.all;

entity func is
    port ( X, Y, Z : IN std_logic;
                  F : OUT std_logic);
end func;

architecture structural of func is
begin
    F <= (X OR (NOT(X) AND Y))
   AND (NOT(Y) OR (X AND NOT(Z)))
end structural ^XkazGoyD

library IEEE;
use IEEE.std_logic_1164.all;

entity func is
    port ( X, Y, Z : IN std_logic;
                  F : OUT std_logic);
end func;

architecture behavioral of func is
signal s :
        std_logic_vector(2 downto 0);
begin
    s <= X & Y & Z;

    with s select
        F  <= '1' when 
                            '100' | '101' | '110',
                  '0' when others;
end behavioral ^jq1b811F

